# ──────────────────────────────────────────────────────────────
# Flapjack — Bring Your Own Key (BYOK)  [OPTIONAL]
# These env vars only SEED your first profile/connectors on a fresh store.
# The normal way to configure Flapjack is the CLI:
#   flapjack profile add --name Default --provider openai --model gpt-4o-mini --key sk-...
#   flapjack connectors set --slack-webhook ... --inbound-secret ...
# Copy this file to .env.local if you'd rather seed from the environment.
# Nothing here is ever sent anywhere except the AI service you choose.
# ──────────────────────────────────────────────────────────────

# Provider for the seeded default profile:
#   openai | anthropic | gemini | openai-compatible
FLAPJACK_PROVIDER=openai

# Your API key (stored locally in .data/store.json; only sent to your provider)
FLAPJACK_API_KEY=

# Default model id
FLAPJACK_MODEL=gpt-4o-mini

# Optional: override the base URL.
# - OpenAI:            https://api.openai.com/v1            (default)
# - Anthropic:         https://api.anthropic.com            (provider=anthropic)
# - Google Gemini:     (leave blank — handled automatically) (provider=gemini)
# - OpenRouter:        https://openrouter.ai/api/v1          (provider=openai-compatible)
# - Together:          https://api.together.xyz/v1           (provider=openai-compatible)
# - Groq:              https://api.groq.com/openai/v1        (provider=openai-compatible)
# - Local Ollama:      http://127.0.0.1:11434/v1             (provider=openai-compatible)
# - Local LM Studio:   http://127.0.0.1:1234/v1              (provider=openai-compatible)
FLAPJACK_BASE_URL=

# The company/context name agents use.
FLAPJACK_COMPANY=Your Company

# ── Chat connectors (all optional — easiest setup is just a webhook URL) ──
# Outbound: mirror agent updates into Slack/Discord.
FLAPJACK_SLACK_WEBHOOK=
FLAPJACK_DISCORD_WEBHOOK=

# Inbound (two-way): let your team trigger agents with /flapjack.
# Slack slash command verification:
FLAPJACK_SLACK_SIGNING_SECRET=
# Discord interactions verification (application public key, hex):
FLAPJACK_DISCORD_PUBLIC_KEY=
# Shared secret for the generic inbound endpoint (cron / custom bots):
FLAPJACK_INBOUND_SECRET=
